generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Supabase Postgres — the SAME database for local dev AND production.
  // Local dev: point DATABASE_URL at your Supabase connection string too
  // (from Supabase Dashboard → Settings → Database → Connection string).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("New conversation")
  kind      String        @default("chat") // "chat" | "agent"
  // Phase 0 Bug 3: ownership. null = guest session (any guest may resume).
  // Non-null = owned by a specific authenticated user; only that user may resume.
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Phase 1 P3: optional project binding. When set, the session belongs to a
  // specific Project — the project's custom instructions + files are injected
  // into the system prompt for every message in this session. null = a loose
  // chat not tied to any project. SetNull on project delete keeps the session
  // history accessible (the session just loses its project context).
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String       @id @default(cuid())
  sessionId String
  session   ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant" | "tool"
  content   String
  thinking  String? // assistant reasoning shown in the thinking panel
  toolName  String? // when role=tool: which connector ran
  toolData  String? // when role=tool: JSON { args, result }
  createdAt DateTime     @default(now())

  @@index([sessionId, createdAt])
}

// Phase 0 Bug 3: also add a relation from User to ChatSession.
// (Added in the User model below via sessions ChatSession[].)

model GeneratedImage {
  id        String   @id @default(cuid())
  prompt    String
  size      String
  url       String
  provider  String   @default("nexus")
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model GeneratedVideo {
  id        String   @id @default(cuid())
  prompt    String
  scenes    Int      @default(4)
  voice     String   @default("en-US-AriaNeural")
  style     String   @default("cinematic")
  url       String?
  jobId     String?
  status    String   @default("planning") // planning | images | narration | rendering | done | error
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model GeneratedDocument {
  id          String   @id @default(cuid())
  filename    String
  format      String   @default("docx") // docx | txt | md
  title       String
  summary     String   @default("")
  downloadUrl String
  size        Int      @default(0)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  passwordHash  String
  interests     String   @default("[]") // JSON array
  commStyle     String   @default("balanced")
  avatarUrl     String?  // path/URL to uploaded profile picture
  bio           String?  // free-text "about me" (max ~500 chars)
  location      String?  // city, country
  timezone      String?  // IANA name e.g. "Asia/Dubai"
  language      String   @default("en") // UI language pref synced to DB
  jobTitle      String?
  website       String?
  notifications Boolean  @default(true)    // product/marketing emails opt-in
  emailVerified Boolean  @default(false)
  lastActiveAt  DateTime? // for presence / sliding session
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images        GeneratedImage[]
  videos        GeneratedVideo[]
  documents     GeneratedDocument[]
  sessions      ChatSession[]   // Phase 0 Bug 3: back-relation for ownership
  memories      UserMemory[]    // Phase 1 P1: per-user durable memory
  projects      Project[]       // Phase 1 P3: per-user persistent projects
}

model EmailAccount {
  id            String    @id @default(cuid())
  label         String
  email         String
  fromName      String    @default("")
  imapHost      String
  imapPort      Int       @default(993)
  smtpHost      String
  smtpPort      Int       @default(465)
  smtpSecure    Boolean   @default(true)
  username      String
  passwordEnc   String
  status        String    @default("unverified") // unverified | connected | error
  statusMessage String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AiProvider {
  id           String   @id @default(cuid())
  providerId   String   @unique // "openrouter" | "groq" | "gemini" | "mistral" | "cerebras" | "together"
  label        String
  apiKeyEnc    String
  baseUrl      String
  defaultModel String
  status       String   @default("unverified") // unverified | connected | error
  statusMessage String  @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Phase 1 — Priority 1: per-user memory store.
// Distinct from per-session ChatMessage history. Each row is one durable
// fact the user asked NEXUS to remember about them (or that they added
// manually from the profile page). Injected into the system prompt for
// future sessions owned by the same userId (Phase 0 Bug 3 scoping).
model UserMemory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         String   // the durable fact (≤ 600 chars enforced at API layer)
  // When the memory was captured from a chat session, the session id it
  // came from. null when added manually from the profile page.
  sourceSessionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}

// Phase 1 — Priority 3: persistent projects with multi-session + files +
// custom instructions. A Project is a durable "folder of work" owned by a
// user. Chat sessions optionally bind to a project via ChatSession.projectId;
// when bound, the project's customInstructions + ProjectFile contents are
// injected into the chat system prompt so NEXUS has persistent context for
// every conversation in that project. Files are stored as text content
// (≤ 200KB per file, capped at API layer) — sufficient for source code,
// markdown notes, JSON configs, CSVs, and small reference docs.
model Project {
  id                 String   @id @default(cuid())
  userId             String   // owner (required — projects are user-scoped)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String   // display name (≤ 100 chars enforced at API)
  description        String   @default("")  // short blurb (≤ 500 chars)
  color              String   @default("amber") // gradient key for the UI
  // Persistent custom instructions for this project (≤ 4000 chars). Injected
  // into the system prompt for every chat session bound to this project.
  // Example: "Always answer in the context of mobile app dev. Use TypeScript.
  // The target audience is the senior eng team."
  customInstructions String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions  ChatSession[]   // back-relation for project-scoped sessions
  files     ProjectFile[]   // back-relation for project reference files

  @@index([userId, updatedAt])
}

// Phase 1 P3: a reference file attached to a Project. Content is stored as
// text in SQLite (capped at 200KB per file, max 50 files per project, both
// enforced at the API layer). Sufficient for source code, markdown, JSON,
// CSVs, plain-text notes. Binary file support (PDFs, docx, images) is out
// of scope for V1 — the chat route injects file text into the system prompt
// so NEXUS has durable, project-scoped knowledge of these files.
model ProjectFile {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename   String   // user-facing name (≤ 200 chars)
  mimeType   String   @default("text/plain")
  size       Int      @default(0) // byte length of `content`
  content    String   @default("") // text content (≤ 200KB enforced at API)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId, createdAt])
}

# ============================================================================
# NEXUS AI — ENVIRONMENT VARIABLE TEMPLATE
# ============================================================================
# Copy this file to `.env.local` (for local dev) or set these in your Vercel
# project settings (for production). NEVER commit `.env.local` — it's
# gitignored. This template contains ONLY placeholder values.

# ---- Database ----
# Local dev: SQLite file. Vercel: use Supabase Postgres connection string
# (Settings → Database → Connection string → "URI" → Transaction pooler).
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL="file:./db/custom.db"

# ---- Supabase (cloud sync + auth + Postgres) ----
# Your project URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon (publishable) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role (secret) key — SERVER SIDE ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- OpenRouter (premium pool member — round-robin load balancing) ----
# NOTE: all configured providers below form a ROUND-ROBIN pool: every
# request rotates across OpenRouter / Hugging Face / Grok / Vercel AI
# Gateway / Agnes, so quota spreads evenly and never runs out fast.
# Any provider that fails is skipped automatically (seamless failover).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default model: "Ox Alpha" (stealth/ox-alpha) — a FREE coding/reasoning model
# with 1M token context + multimodal input. See https://openrouter.ai/models
# for the full catalog (users can also switch in Settings -> AI Models).
OPENROUTER_DEFAULT_MODEL=stealth/ox-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Shown in OpenRouter rankings (optional but appreciated)
OPENROUTER_SITE_URL=https://your-domain.vercel.app
OPENROUTER_APP_NAME=NEXUS AI

# ---- Agnes AI (video generation + optional chat) ----
AGNES_API_KEY=sk-agnes-key
AGNES_BASE_URL=https://api.agnes.ai/v1
# Optional: model id for Agnes chat completions (if their chat API is used)
# AGNES_CHAT_MODEL=default

# ---- xAI Grok (premium pool member) ----
# Get a key at https://console.x.ai
XAI_API_KEY=gsk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Vercel AI Gateway (premium pool member) ----
# ONE key -> GPT-4.1, Claude, Grok, DeepSeek, Llama (per-token billing).
# Create it in the Vercel dashboard: AI Gateway -> API keys.
# NOTE: a regular Vercel deploy token (vcp_...) does NOT work here —
# you need a dedicated AI Gateway key.
VERCEL_AI_GATEWAY_API_KEY=vck_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Hugging Face (premium pool member + server-side Whisper ASR) ----
# Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Email connector encryption secret ----
# Any random 32+ char string. Used to encrypt stored IMAP/SMTP passwords.
# Generate with: openssl rand -hex 32
NEXUS_EMAIL_SECRET=change-me-to-a-random-32-char-string

# ---- Session JWT signing secret (REQUIRED in production) ----
# Signs the 30-day session cookies. Must be a random 32+ char string.
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-32-char-string

# ---- WhatsApp webhook signature verification (optional but recommended) ----
# The Meta app secret from your WhatsApp Business app. Lets the webhook
# verify X-Hub-Signature-256 so spoofed webhooks are rejected.
WHATSAPP_APP_SECRET=your-meta-app-secret

# ---- App config ----
APP_URL=http://localhost:3000
PORT=3000

# ---- Admin migration endpoint (one-shot DB provisioning) ----
# Required for /api/admin/migrate in production (Vercel). Any random 32+ char
# string. Used to provision the Supabase schema from the Vercel runtime when
# the pooler returns `tenant not found` from outside Supabase's network.
# Generate with: openssl rand -hex 24
ADMIN_MIGRATION_TOKEN=change-me-to-a-random-32-char-string

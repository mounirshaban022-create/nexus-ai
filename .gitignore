# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the .env.example template IS committed (placeholder values only)
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
/test
prompt

server.log
# dev screenshots / session artifacts — never commit
/*.png
/agent-ctx/
/tool-results/
*.bak
/download/
# Skills directory
/skills/
# NEXUS: never commit runtime data, secrets, or generated files
db/
generated-images/
generated-videos/
generated-documents/*
!generated-documents/.gitkeep
upload/
*.pid
.env.example.local
worklog.md


# agent tool-results (not for the repo)
tool-results

# heavyweight local tooling binaries — never commit (290MB+)
/ocr/
/stirling/
/agent-ctx/*.png
*.jar
/jdk*/

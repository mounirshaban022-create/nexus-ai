{
  "name": "nexus-ai",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "node -e \"const fs=require('fs');if(process.env.DATABASE_URL&&process.env.DATABASE_URL.startsWith('postgres')){let s=fs.readFileSync('prisma/schema.prisma','utf8');s=s.replace('provider = \\\"sqlite\\\"','provider = \\\"postgresql\\\"');fs.writeFileSync('prisma/schema.prisma',s);}console.log('Provider:', process.env.DATABASE_URL?.startsWith('postgres') ? 'postgresql' : 'sqlite')\" && prisma generate && next build",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
